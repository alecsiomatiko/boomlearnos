# =====================================================
# BASE DE DATOS MYSQL
# =====================================================
# Configuración de tu servidor MySQL
# Puede ser local (localhost) o remoto (Hostinger, PlanetScale, etc.)

DB_HOST=srv440.hstgr.io                    # Host del servidor MySQL
DB_PORT=3306                                # Puerto (default: 3306)
DB_USER=u191251575_BoomlearnOS             # Usuario de la base de datos
DB_PASSWORD=tu_password_super_secreto      # Contraseña (NUNCA subir a Git!)
DB_NAME=u191251575_BoomlearnOS             # Nombre de la base de datos

# =====================================================
# OPENAI (para análisis con IA)
# =====================================================
# Obtén tu API key en: https://platform.openai.com/api-keys
# Sin esto, el análisis IA no funcionará (pero el resto del sistema sí)

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =====================================================
# JWT (JSON Web Tokens)
# =====================================================
# Secret key para firmar los tokens de autenticación
# Usa un string largo y random. Puedes generarlo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=pon_aqui_un_string_super_largo_y_random_minimo_32_caracteres
NEXT_PUBLIC_JWT_SECRET=el_mismo_string_de_arriba

# =====================================================
# NEXT.JS
# =====================================================
# URL base del API
# Desarrollo: http://localhost:3000
# Producción: https://tu-dominio.com

NEXT_PUBLIC_API_URL=http://localhost:3000

# En producción cambia a:
# NEXT_PUBLIC_API_URL=https://tudominio.com

# =====================================================
# EMAIL (Opcional - para futuro)
# =====================================================
# Configuración SMTP para notificaciones por email
# De momento no se usa, pero está preparado

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASSWORD=tu-app-password-de-gmail
# SMTP_FROM=BoomLearnOS <noreply@boomlearnos.com>

# =====================================================
# OTRAS CONFIGURACIONES
# =====================================================

# Modo de desarrollo vs producción
NODE_ENV=development

# =====================================================
# TIPS IMPORTANTES
# =====================================================
#
# - Copia este archivo a .env y llena los valores
# - NUNCA subas el .env con valores reales a Git
# - Guarda las credenciales de producción en tu hosting
# - Reinicia el servidor después de cambiar el .env
# - Para Vercel/Netlify, usa el dashboard para variables
# - Para Hostinger, usa el panel de control de Node.js
#
# =====================================================

